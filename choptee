<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Chop Tee Nails | ร้านทำเล็บมินิมอล</title>
<link href="https://fonts.googleapis.com/css2?family=Mali:wght@600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#fffafa;--pink:#f6d3dc;--pink-d:#e9a9bb;--brown:#a8877a;--grey:#8c8a8d;--ink:#3a3033;--card:#fff;--line:#f0e2e5;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#231d1f;--pink:#4a2f38;--pink-d:#e9a9bb;--brown:#d1b0a3;--grey:#b3b0b3;--ink:#f6ecee;--card:#2d2528;--line:#3d3236}}
:root[data-theme="dark"]{--bg:#231d1f;--pink:#4a2f38;--pink-d:#e9a9bb;--brown:#d1b0a3;--grey:#b3b0b3;--ink:#f6ecee;--card:#2d2528;--line:#3d3236}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:64px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.7 "IBM Plex Sans Thai",system-ui,sans-serif}
h1,h2,h3{font-family:Mali,"IBM Plex Sans Thai",cursive;line-height:1.3;margin:0}
a{color:inherit}
.wrap{max-width:960px;margin:0 auto;padding:0 20px}
section{padding:56px 0}
h2{font-size:1.7rem;margin-bottom:8px}
.sub{color:var(--grey);margin:0 0 28px}
nav{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:56px}
.logo{font-family:Mali,cursive;font-weight:700;font-size:1.25rem;text-decoration:none}
.logo i{font-style:normal;color:var(--pink-d)}
nav ul{display:flex;gap:18px;list-style:none;margin:0;padding:0;font-size:.9rem}
nav a{text-decoration:none}
@media(max-width:560px){nav ul li:nth-child(n+3):not(:last-child){display:none}}
.btn{display:inline-block;background:var(--ink);color:var(--bg);border:0;border-radius:999px;padding:12px 26px;font:500 1rem "IBM Plex Sans Thai",sans-serif;text-decoration:none;cursor:pointer}
.btn.soft{background:var(--pink);color:var(--ink)}
:focus-visible{outline:3px solid var(--pink-d);outline-offset:2px}
.hero{padding:48px 0 40px;background:linear-gradient(180deg,var(--pink) -40%,var(--bg) 100%)}
.hero .wrap{display:grid;gap:28px;align-items:center}
@media(min-width:760px){.hero .wrap{grid-template-columns:1.1fr .9fr}}
.hero h1{font-size:clamp(2rem,6vw,3.2rem)}
.hero p{max-width:34ch;color:var(--grey);font-size:1.05rem}
.cta{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.hand{display:flex;justify-content:center;gap:10px;align-items:flex-end;height:230px}
.nail{width:44px;border-radius:22px 22px 14px 14px;position:relative;box-shadow:inset 6px 0 0 rgba(255,255,255,.55),0 6px 14px rgba(120,80,90,.15)}
.nail:nth-child(1){height:110px;background:#f6d3dc}
.nail:nth-child(2){height:150px;background:#fff;border:1.5px solid var(--pink)}
.nail:nth-child(3){height:170px;background:linear-gradient(#f6d3dc,#fff)}
.nail:nth-child(4){height:150px;background:#d9bfb3}
.nail:nth-child(5){height:100px;background:#c9c7ca}
.nail{animation:rise .9s ease-out both}
.nail:nth-child(2){animation-delay:.1s}.nail:nth-child(3){animation-delay:.2s}.nail:nth-child(4){animation-delay:.3s}.nail:nth-child(5){animation-delay:.4s}
@keyframes rise{from{transform:translateY(40px);opacity:0}}
@media(prefers-reduced-motion:reduce){.nail{animation:none}html{scroll-behavior:auto}}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}
.chip{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:6px 16px;font:inherit;font-size:.9rem;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--pink);border-color:var(--pink-d)}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px}
.card[hidden]{display:none}
.swatch{height:92px;border-radius:12px;display:flex;justify-content:center;align-items:center;gap:6px;margin-bottom:10px}
.swatch b{width:22px;height:54px;border-radius:12px 12px 8px 8px;background:var(--c1);box-shadow:inset 3px 0 0 rgba(255,255,255,.5)}
.swatch b:nth-child(even){background:var(--c2)}
.card h3{font-size:1rem}
.card p{margin:2px 0 0;font-size:.85rem;color:var(--grey)}
.price{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.price .card{border-radius:18px}
.price strong{font-size:1.6rem;font-family:Mali,cursive;color:var(--brown)}
.price ul{margin:8px 0 0;padding-left:18px;color:var(--grey);font-size:.92rem}
.promo{background:var(--pink);border-radius:24px;padding:28px;display:grid;gap:8px}
.steps{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));counter-reset:s}
.steps li{list-style:none;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;counter-increment:s}
.steps li::before{content:counter(s);display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--pink);font-weight:600;margin-bottom:6px}
ol.steps{padding:0;margin:0}
form{display:grid;gap:12px;max-width:520px}
label{display:grid;gap:4px;font-size:.92rem;font-weight:500}
input,select,textarea{font:inherit;padding:11px 14px;border:1px solid var(--line);border-radius:12px;background:var(--card);color:var(--ink)}
.out{white-space:pre-wrap;background:var(--card);border:1px dashed var(--pink-d);border-radius:14px;padding:14px;margin-top:6px}
.out[hidden]{display:none}
.rv{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
.rv blockquote{margin:0;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px}
.rv cite{display:block;margin-top:8px;font-style:normal;color:var(--grey);font-size:.85rem}
.two{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
footer{border-top:1px solid var(--line);padding:28px 0;color:var(--grey);font-size:.9rem;text-align:center}
</style>
</head>
<body>
<nav><div class="wrap">
<a class="logo" href="#top">Chop Tee <i>Nails</i></a>
<ul><li><a href="#designs">แบบเล็บ</a></li><li><a href="#price">ราคา</a></li><li><a href="#promo">โปรโมชั่น</a></li><li><a href="#book">จองคิว</a></li></ul>
</div></nav>

<header class="hero" id="top"><div class="wrap">
<div>
<h1>เล็บสวยได้ทุกวัน<br>ในราคาที่เข้าถึงง่าย</h1>
<p>ร้านทำเล็บสไตล์มินิมอล เล็บสวย ตรงเรฟ งานเนี้ยบ บริการเป็นกันเอง</p>
<div class="cta"><a class="btn" href="#book">จองคิวเลย</a><a class="btn soft" href="#designs">ดูแบบเล็บ</a></div>
</div>
<div class="hand" aria-hidden="true"><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span></div>
</div></header>

<section id="designs"><div class="wrap">
<h2>แบบเล็บ</h2>
<p class="sub">เลือกตามเรฟที่ชอบ ถ้ามีรูปในใจ ส่งมาให้ช่างดูได้เลย</p>
<div class="chips" role="group" aria-label="กรองแบบเล็บ">
<button class="chip" data-f="all" aria-pressed="true">ทั้งหมด</button>
<button class="chip" data-f="minimal" aria-pressed="false">มินิมอล</button>
<button class="chip" data-f="korean" aria-pressed="false">สไตล์เกาหลี</button>
<button class="chip" data-f="cute" aria-pressed="false">น่ารัก</button>
</div>
<div class="grid" id="grid"></div>
</div></section>

<section id="price"><div class="wrap">
<h2>ราคา</h2>
<p class="sub">ราคานักศึกษาเป็นมิตร ไม่มีบวกเพิ่มแอบแฝง</p>
<div class="price">
<div class="card"><h3>เล็บสีเจล</h3><strong>฿299</strong><ul><li>สีพื้น / ชมพูนู้ด</li><li>ตะไบ ตัดหนัง ทาสี</li></ul></div>
<div class="card"><h3>เล็บลายมินิมอล</h3><strong>฿449</strong><ul><li>ฝรั่งเศส ลายเส้น ชิมเมอร์</li><li>ออกแบบตามเรฟ</li></ul></div>
<div class="card"><h3>เล็บเกาหลี</h3><strong>฿599</strong><ul><li>เพ้นท์ ติดอะไหล่ ออร่า</li><li>ตกแต่งเต็มมือ</li></ul></div>
</div>
<p class="sub" style="margin-top:14px">*ราคาตัวอย่าง ปรับตามจริงของร้านได้</p>
</div></section>

<section id="promo"><div class="wrap">
<div class="promo">
<h2>โปรโมชั่น</h2>
<div><b>ลูกค้าใหม่ลด 10%</b> เมื่อจองผ่าน DM หรือ Line</div>
<div><b>รีวิวลงโซเชียล</b> แท็กร้านเพื่อรับส่วนลดครั้งถัดไป</div>
<div><b>ชวนเพื่อนมาทำคู่</b> ทั้งสองคนได้ส่วนลด</div>
</div>
</div></section>

<section id="how"><div class="wrap">
<h2>ขั้นตอนใช้บริการ</h2>
<p class="sub">ง่ายๆ ตั้งแต่เลือกแบบจนกลับบ้านพร้อมเล็บสวย</p>
<ol class="steps">
<li><b>เช็กเรฟเล็บ</b><br>เลือกแบบจากหน้านี้หรือ IG/TikTok</li>
<li><b>จองคิว</b><br>ส่ง DM หรือ Line</li>
<li><b>มาที่ร้าน</b><br>เดินทางมาตามเวลานัด</li>
<li><b>ทำเล็บ</b><br>ช่างทำตามแบบที่เลือก</li>
<li><b>ถ่ายรูปลงโซเชียล</b><br>แท็กร้านรับส่วนลด</li>
</ol>
</div></section>

<section id="book"><div class="wrap">
<h2>จองคิว</h2>
<p class="sub">กรอกข้อมูล แล้วคัดลอกข้อความส่งทาง DM หรือ Line ของร้าน</p>
<form id="f">
<label>ชื่อเล่น<input id="n" required placeholder="เช่น มายด์"></label>
<label>บริการ<select id="s"><option>เล็บสีเจล</option><option>เล็บลายมินิมอล</option><option>เล็บเกาหลี</option></select></label>
<label>วัน/เวลาที่สะดวก<input id="d" required placeholder="เช่น เสาร์นี้ ช่วงบ่าย"></label>
<label>แบบที่ชอบ (ถ้ามี)<textarea id="m" rows="2" placeholder="แนบรูปเรฟใน DM ได้เลย"></textarea></label>
<button class="btn" type="submit">สร้างข้อความจอง</button>
<div class="out" id="o" hidden></div>
<button class="btn soft" type="button" id="cp" hidden>คัดลอกข้อความ</button>
</form>
</div></section>

<section id="review"><div class="wrap">
<h2>รีวิวจากลูกค้า</h2>
<p class="sub">ตัวอย่างรีวิว เปลี่ยนเป็นของลูกค้าจริงได้</p>
<div class="rv">
<blockquote>เล็บตรงเรฟมาก ช่างใส่ใจรายละเอียดสุดๆ ราคานักศึกษาจ่ายไหว<cite>ลูกค้า 1</cite></blockquote>
<blockquote>ร้านน่ารัก บรรยากาศสบาย ถ่ายรูปลง IG สวยทุกมุม<cite>ลูกค้า 2</cite></blockquote>
<blockquote>ทำเล็บเกาหลีเสร็จเร็ว ติดทนหลายสัปดาห์<cite>ลูกค้า 3</cite></blockquote>
</div>
</div></section>

<section id="care"><div class="wrap two">
<div class="card"><h3>ดูแลเล็บหลังทำ</h3><p>ทาน้ำมันบำรุงเล็บทุกวัน ใส่ถุงมือเวลาล้างจาน และไม่แคะเล็บเจล ร้านมีคำแนะนำให้ทุกครั้งหลังทำเสร็จ</p></div>
<div class="card"><h3>การเดินทาง</h3><p>เดินทางมาที่ร้านโดยตรง (ไม่มีบริการส่ง) ทักแชทเพื่อรับแผนที่และดูคิวว่างก่อนมา</p></div>
</div></section>

<footer><div class="wrap">
<p><b>Chop Tee Nails</b> ติดตามได้ที่ IG / TikTok / Line: @choptee (ตัวอย่าง)</p>
<p>ร้านทำเล็บสไตล์มินิมอลที่ให้คุณสวยได้ทุกวัน</p>
</div></footer>

<script>
var items=[
["สีนู้ดชมพู","minimal","#f6d3dc","#f9e3e8","เรียบ สะอาดตา"],
["ฝรั่งเศสมินิมอล","minimal","#fff","#f6d3dc","คลาสสิกใส่ได้ทุกวัน"],
["ลายเส้นบาง","minimal","#e9dcd5","#fff","เส้นเล็กๆ ดูแพง"],
["ออร่าเกาหลี","korean","#f3b7c9","#fff0f4","ไล่สีฟุ้งๆ"],
["ชิมเมอร์ใส","korean","#eee5ee","#d8c8dc","วิบวับนุ่มๆ"],
["ตาแมวสีเทา","korean","#c9c7ca","#e8e6e8","เงาเหลือบ"],
["หัวใจน้อย","cute","#f6d3dc","#fff","ติดหัวใจเล็กๆ"],
["น้ำตาลอ่อนหวานๆ","cute","#d9bfb3","#f2e4dc","โทนอบอุ่นน่ารัก"]
];
var g=document.getElementById("grid");
items.forEach(function(i){var c=document.createElement("div");c.className="card";c.dataset.k=i[1];
c.innerHTML='<div class="swatch" style="background:var(--pink);--c1:'+i[2]+';--c2:'+i[3]+'"><b></b><b></b><b></b><b></b></div><h3>'+i[0]+'</h3><p>'+i[4]+'</p>';g.appendChild(c)});
document.querySelectorAll(".chip").forEach(function(b){b.onclick=function(){
document.querySelectorAll(".chip").forEach(function(x){x.setAttribute("aria-pressed",x===b)});
var f=b.dataset.f;g.querySelectorAll(".card").forEach(function(c){c.hidden=f!=="all"&&c.dataset.k!==f})}});
var o=document.getElementById("o"),cp=document.getElementById("cp");
document.getElementById("f").onsubmit=function(e){e.preventDefault();
o.textContent="สวัสดีค่ะ Chop Tee Nails\nชื่อ: "+n.value+"\nบริการ: "+s.value+"\nวัน/เวลา: "+d.value+(m.value?"\nแบบที่ชอบ: "+m.value:"")+"\nขอจองคิวค่ะ";
o.hidden=false;cp.hidden=false};
cp.onclick=function(){try{navigator.clipboard.writeText(o.textContent);cp.textContent="คัดลอกแล้ว"}catch(x){cp.textContent="กดค้างที่ข้อความเพื่อคัดลอก"}};
</script>
</body>
</html>
